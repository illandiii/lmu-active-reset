<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Sector" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Content}"
        FontFamily="Segoe UI" FontSize="14">
  <StackPanel Margin="24">
    <TextBlock Text="Keep Sector running?" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="In the background, your shortcuts stay active and your checkpoint stays available. Open Sector from the tray to return here."
               Foreground="{DynamicResource Secondary}" Margin="0,0,0,20"/>
    <Button x:Name="KeepRunning" Content="Run in background" IsDefault="True" Margin="0,0,0,8"/>
    <Button x:Name="QuitSector" Content="Quit Sector" Margin="0,0,0,8"/>
    <Button Content="Cancel" IsCancel="True" Background="Transparent"/>
  </StackPanel>
</Window>
