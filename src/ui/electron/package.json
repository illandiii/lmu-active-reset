{
  "name": "sector-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Sector desktop companion for Le Mans Ultimate",
  "type": "module",
  "main": "main/index.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "preview": "electron . --preview",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/electron-smoke.mjs && node tests/overlay-smoke.mjs",
    "format": "prettier --write build main renderer shared tests *.json *.js *.html",
    "format:check": "prettier --check build main renderer shared tests *.json *.js *.html",
    "release": "npm run build && node build/release.mjs",
    "test:release": "node tests/release-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/manrope": "^5.2.8",
    "@iconify-icons/solar": "2.0.4",
    "@iconify/react": "^6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rcedit": "^5.0.2",
    "vite": "8.3.4"
  }
}
