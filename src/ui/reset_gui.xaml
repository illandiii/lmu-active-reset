<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sector" Width="580" Height="660" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Content}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Card" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Content" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Secondary" Color="#B0B0B8"/>
    <SolidColorBrush x:Key="Accent" Color="#73B7FF"/>
    <SolidColorBrush x:Key="Signal" Color="#E8B378"/>
    <SolidColorBrush x:Key="Line" Color="#454549"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Primary" Color="#0066CC"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#3A3A3E"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Content}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" Margin="2,4">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="28" Cursor="Hand">
              <Thumb.Template><ControlTemplate TargetType="Thumb">
                <Border x:Name="Handle" Background="{DynamicResource Line}" CornerRadius="3"/>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Secondary}"/></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="TabSurface" CornerRadius="8" Padding="18,10" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Content}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LineIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{DynamicResource Secondary}"/><Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Geometry x:Key="ResetIcon">M 3 10 A 9 9 0 1 1 5 19 M 3 4 L 3 10 L 9 10</Geometry>
    <Geometry x:Key="LayersIcon">M 3 7 L 12 2 L 21 7 L 12 12 Z M 3 12 L 12 17 L 21 12 M 3 17 L 12 22 L 21 17</Geometry>
    <Geometry x:Key="SaveIcon">M 4 3 L 17 3 L 21 7 L 21 21 L 3 21 L 3 3 Z M 7 3 L 7 9 L 16 9 L 16 3 M 7 21 L 7 14 L 17 14 L 17 21</Geometry>
    <Geometry x:Key="SoundIcon">M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 Q 20 12 16 16 M 19 5 Q 26 12 19 19</Geometry>
  </Window.Resources>
  <Grid x:Name="LayoutRoot">
    <Grid x:Name="MainContent">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="28,24,28,18">
        <Image x:Name="BrandMark" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Sector logo"/>
        <TextBlock Text="Sector" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <UniformGrid Grid.Row="1" Columns="2" Margin="28,0,28,20">
        <RadioButton x:Name="ResetTab" GroupName="MainTabs" IsChecked="True" Style="{StaticResource TabButton}" AutomationProperties.Name="Active Reset tab">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ResetIcon}" Style="{StaticResource LineIcon}" Margin="0,0,9,0"/><TextBlock Text="Active Reset"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="OverlayTab" GroupName="MainTabs" Style="{StaticResource TabButton}" AutomationProperties.Name="Overlay tab">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LayersIcon}" Style="{StaticResource LineIcon}" Margin="0,0,9,0"/><TextBlock Text="Overlay"/></StackPanel>
        </RadioButton>
      </UniformGrid>
      <ScrollViewer x:Name="ResetPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="28,0,28,24">
          <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="20" Margin="0,0,0,24">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Secondary}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusTitle" Text="Waiting for LMU" FontSize="12"/>
              </StackPanel>
              <TextBlock x:Name="CheckpointState" Text="No checkpoint" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock x:Name="CheckpointSummary" Foreground="{DynamicResource Secondary}" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="LastEvent" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16,4" Margin="0,0,0,24">
            <StackPanel>
              <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{StaticResource SaveIcon}" Style="{StaticResource LineIcon}" Margin="0,0,12,0"/><TextBlock Text="Save checkpoint"/></StackPanel>
                <Button x:Name="SaveKey" Grid.Column="1" Content="F6" MinWidth="88" AutomationProperties.Name="Assign save key"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource Line}"/>
              <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{StaticResource ResetIcon}" Style="{StaticResource LineIcon}" Margin="0,0,12,0"/><TextBlock Text="Restore checkpoint"/></StackPanel>
                <Button x:Name="RestoreKey" Grid.Column="1" Content="F7" MinWidth="88" AutomationProperties.Name="Assign restore key"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="Audio" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16,12">
            <StackPanel>
              <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{StaticResource SoundIcon}" Style="{StaticResource LineIcon}" Margin="0,0,12,0"/><TextBlock Text="Sound feedback"/></StackPanel>
                <CheckBox x:Name="SoundEnabled" Grid.Column="1" IsChecked="True" AutomationProperties.Name="Sound feedback" Cursor="Hand">
              <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                <Border x:Name="SwitchFocus" Padding="3" BorderThickness="2" BorderBrush="Transparent" CornerRadius="16">
                  <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource Secondary}">
                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource OnPrimary}" HorizontalAlignment="Left" Margin="3"/>
                  </Border>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.65"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></CheckBox.Template>

                </CheckBox>
              </Grid>
              <UniformGrid x:Name="SoundPreviews" Columns="2">
                <Button x:Name="PreviewSave" Content="Test save" Margin="0,0,6,0" FontSize="13"/>
                <Button x:Name="PreviewRestore" Content="Test restore" Margin="6,0,0,0" FontSize="13"/>
              </UniformGrid>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SettingsHint" Foreground="{DynamicResource Signal}" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="OverlayPanel" Grid.Row="2" Visibility="Collapsed" Margin="28,0,28,24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="{StaticResource LayersIcon}" Style="{StaticResource LineIcon}" Width="36" Height="36" Margin="0,0,0,16"/>
          <TextBlock Text="Overlay" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Coming soon" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#B3000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="24" MaxWidth="400" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel x:Name="CaptureCard" Visibility="Collapsed">
            <TextBlock x:Name="CaptureTitle" Text="Save shortcut" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Press a key" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <TextBlock x:Name="CaptureHint" Text="Esc to cancel" Foreground="{DynamicResource Secondary}" Margin="0,0,0,20" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="CancelCapture" Content="Cancel"/>
          </StackPanel>
          <StackPanel x:Name="CloseCard" Visibility="Collapsed">
            <TextBlock Text="Keep Sector running?" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Shortcuts stay active in the background." Foreground="{DynamicResource Secondary}" Margin="0,0,0,22"/>
            <Button x:Name="KeepRunning" Content="Run in background" Margin="0,0,0,8"/>
            <Button x:Name="QuitSector" Content="Quit Sector" Margin="0,0,0,8"/>
            <Button x:Name="CancelClose" Content="Cancel" Background="Transparent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
